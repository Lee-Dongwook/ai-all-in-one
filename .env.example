# Docker Compose defaults to the bundled Ollama container at http://ollama:11434.
# For a separate private-network Ollama server, uncomment and set its address.
# OLLAMA_BASE_URL=http://10.0.0.20:11434

OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# The API is only exposed on localhost by default. Change deliberately if a
# reverse proxy or internal network must reach it.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

# Pin a version or digest before production deployment.
OLLAMA_IMAGE=ollama/ollama:latest
